# 앱에 넣는 값은 프록시 주소, Supabase 공개 키, AI 서버 인증 키다.
# EXPO_PUBLIC_API_SECRET_KEY는 모든 AI 요청의 x-api-key로 보낸다. 서버의 API_SECRET_KEY와 같은 값이다.
# 모델용 OPENAI_API_KEY는 서버 환경 변수에만 둔다.
EXPO_PUBLIC_AI_PROXY_URL=http://127.0.0.1:8787
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_API_SECRET_KEY=
